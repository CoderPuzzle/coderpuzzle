        "obj": {
          "x": 5
        },
        "fn": "(obj) => {\n  obj.x = 5;\n  return obj.x;\n}"
      },
      "expected": {
        "error": "Error Modifying: x"
      }
    },
    {
      "input": {
        "obj": [
          1,
          2,
          3
        ],
        "fn": "(arr) => {\n  arr[1] = {};\n  return arr[2];\n}"
      },
      "expected": {
        "error": "Error Modifying Index: 1"
      }
    },
    {
      "input": {
